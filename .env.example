# ---- Logbook (students' notes, moderated) ----
# Random 32+ char string. Signs the Approve / Hide links and share links.
LOGBOOK_SECRET=
# Passcode for the private moderation page at /admin/logbook?key=...
LOGBOOK_ADMIN_KEY=
# Public site URL used inside notification links (Vercel sets VERCEL_URL for previews).
NEXT_PUBLIC_SITE_URL=https://www.osamadives.com

# Storage: Vercel -> Storage -> Create Database (Neon Postgres). Vercel injects DATABASE_URL.
DATABASE_URL=
# Photos: Vercel -> Storage -> Create Blob store. Vercel injects BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=

# Notifications. Telegram: create a bot with @BotFather, then message it once and
# read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Optional email copy via Resend (https://resend.com). Comma-separated recipients.
RESEND_API_KEY=
LOGBOOK_NOTIFY_EMAILS=
LOGBOOK_FROM_EMAIL=OsamaDives Logbook <onboarding@resend.dev>

# Optional invisible bot check (https://dash.cloudflare.com -> Turnstile). Off when empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
